# ════════════════════════════════════════════════════
# SUBSENSE Backend — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────
APP_NAME=SUBSENSE Backend
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── MQTT / EMQX ──────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=subsense-backend-01
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=mine
# QoS: 0 = at most once, 1 = at least once, 2 = exactly once
MQTT_QOS=1

# ── Database (Phase 4) ───────────────────────────────
# DATABASE_URL=postgresql+asyncpg://subsense:changeme@localhost:5432/subsense
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# ── ML Model (Phase 8) ───────────────────────────────
# ML_MODEL_PATH=./models/anomaly_detector.pkl
# ML_MODEL_VERSION=mock-0.1.0
